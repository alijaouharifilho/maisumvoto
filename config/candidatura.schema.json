{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Configuração única da candidatura",
  "description": "Único lugar do projeto onde aparecem números e nomes de candidatos, datas e limiares. Lido pelo ETL (Python) e pelo front (TypeScript).",
  "type": "object",
  "required": [
    "esquema",
    "eleicao",
    "alvo",
    "adversario",
    "reclassificarComoNulo",
    "metricas",
    "gruposConversa",
    "calendario",
    "site",
    "mapa",
    "prefixoArmazenamento"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "esquema": {
      "const": 1
    },
    "eleicao": {
      "type": "object",
      "required": [
        "ano",
        "codigo",
        "pleito",
        "turno",
        "cargo",
        "data2T"
      ],
      "properties": {
        "ano": {
          "type": "integer"
        },
        "codigo": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "pleito": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "turno": {
          "type": "integer",
          "enum": [
            1,
            2
          ]
        },
        "cargo": {
          "type": "string"
        },
        "data2T": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "alvo": {
      "$ref": "#/$defs/candidato"
    },
    "adversario": {
      "$ref": "#/$defs/candidato"
    },
    "reclassificarComoNulo": {
      "description": "Números cujos votos nominais o TSE contou como nulos na totalização (candidatura indeferida/renúncia). O ETL soma esses votos em 'nulos'.",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9]{2}$"
      }
    },
    "metricas": {
      "type": "object",
      "required": [
        "raioKm",
        "celulaGraus",
        "gradeLinkGraus",
        "limiarFolga",
        "regraViravel"
      ],
      "properties": {
        "raioKm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "celulaGraus": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "gradeLinkGraus": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "limiarFolga": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 1
        },
        "regraViravel": {
          "enum": [
            "abertos",
            "abertosMaisOutros"
          ]
        }
      }
    },
    "gruposConversa": {
      "description": "Parcela do 'até' → chave do roteiro de conversa. Chaves fixas: abstencao, brancos, nulos; demais chaves são números de candidato.",
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z]+$"
      }
    },
    "calendario": {
      "type": "object",
      "required": [
        "fuso",
        "fases",
        "fasesAbertas"
      ],
      "properties": {
        "fuso": {
          "type": "string"
        },
        "fases": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "id",
              "ate"
            ],
            "properties": {
              "id": {
                "enum": [
                  "campanha",
                  "retaFinal",
                  "pausa",
                  "votacao",
                  "encerrada"
                ]
              },
              "ate": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "fasesAbertas": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "site": {
      "type": "object",
      "required": [
        "nome",
        "dominio",
        "natureza",
        "responsavel",
        "redeSocial",
        "hospedagem"
      ],
      "properties": {
        "nome": {
          "type": "string"
        },
        "dominio": {
          "type": "string"
        },
        "natureza": {
          "enum": [
            "independente",
            "campanha"
          ]
        },
        "responsavel": {
          "type": "object",
          "required": [
            "nome",
            "contato"
          ],
          "description": "Obrigatório antes de publicar (Lei 9.504, art. 57-D). null = ainda não definido; o checador de publicação falha.",
          "properties": {
            "nome": {
              "type": [
                "string",
                "null"
              ]
            },
            "contato": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "redeSocial": {
          "type": [
            "string",
            "null"
          ]
        },
        "hospedagem": {
          "type": [
            "string",
            "null"
          ],
          "description": "Nome do provedor de hospedagem (servidor no Brasil). null = a definir; o checador de publicação falha."
        }
      }
    },
    "mapa": {
      "type": "object",
      "required": [
        "estiloUrl",
        "fonteTiles",
        "centroInicial",
        "zoomInicial"
      ],
      "properties": {
        "estiloUrl": {
          "type": "string"
        },
        "fonteTiles": {
          "type": "string"
        },
        "centroInicial": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "zoomInicial": {
          "type": "number"
        }
      }
    },
    "prefixoArmazenamento": {
      "type": "string",
      "pattern": "^[a-z]{2,8}$"
    }
  },
  "$defs": {
    "candidato": {
      "type": "object",
      "required": [
        "numero",
        "nomeCurto",
        "nomeUrna",
        "partido"
      ],
      "properties": {
        "numero": {
          "type": "string",
          "pattern": "^[0-9]{2}$"
        },
        "nomeCurto": {
          "type": "string"
        },
        "nomeUrna": {
          "type": "string"
        },
        "partido": {
          "type": "string"
        }
      }
    }
  }
}
