{
  "name": "maisumvoto",
  "private": true,
  "version": "0.1.0",
  "description": "Mais um voto — mapa de onde conversar com eleitores no 2º turno de 2026 (site independente de apoio ao 22). Dados: TSE.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5150 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5151 --strictPort",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "e2e": "npm run build && playwright test",
    "py": "node ferramentas/py.mjs",
    "test:py": "node ferramentas/py.mjs -m pytest",
    "dados": "node ferramentas/py.mjs -m etl.montar",
    "checar:publicacao": "node ferramentas/checar-publicacao.mjs",
    "verificar": "npm run lint && npm run typecheck && npm run test && npm run test:deploy && npm run test:py && npm run conferir:citacoes",
    "test:deploy": "node --test \"deploy/testes/*.test.mjs\"",
    "conferir:citacoes": "node ferramentas/py.mjs ferramentas/conferir_citacoes.py",
    "og": "node ferramentas/gerar-og.mjs",
    "publicar": "bash deploy/publicar.sh",
    "validar:nginx": "bash deploy/validar-nginx.sh --funcional"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "maplibre-gl": "^6.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^29.1.1",
    "oxlint": "^1.87.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
